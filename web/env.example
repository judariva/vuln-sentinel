# Variables de build del portal (ADR-0016, ADR-0023). Valores FICTICIOS.
# Los reales van en las variables del pipeline de despliegue; nunca en git.
# Para desarrollo local: copia este fichero a web/.env.local (ignorado por git).

# URL base de la API pública, sin barra final. Vacía = mismo origen que el portal.
VITE_API_BASE_URL=https://api.vuln.example.org
# Nombre que se muestra en la cabecera y en el título.
VITE_BRAND_NAME=vuln-sentinel
