{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuln-sentinel:schema:feed:1.0.0",
  "title": "vuln-sentinel feed 1.0.0",
  "description": "Contrato del feed (PLAN.md §3, ADR-0007, ADR-0019). La raíz valida un registro OSV 1.9.2 extendido (/v1/vulns/{id}.json). Los demás documentos están en $defs: changes_page, alerts_latest, gone y jwks. Las extensiones van en database_specific.vuln_sentinel y en el database_specific de cada affected[].",
  "$ref": "#/$defs/record",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nullable_timestamp": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "alert_id": {
      "type": "string",
      "pattern": "^VS-CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "level": {
      "enum": ["A", "B", "C", "none"]
    },
    "change_type": {
      "enum": [
        "new",
        "withdrawn",
        "level_up",
        "kev_added",
        "poc_added",
        "fix_released",
        "range_completed",
        "epss_jump",
        "updated"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "introduced": { "type": "string" },
        "fixed": { "type": "string" },
        "last_affected": { "type": "string" },
        "limit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["type", "events"],
      "properties": {
        "type": { "enum": ["SEMVER", "ECOSYSTEM", "GIT"] },
        "repo": { "type": "string" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" },
          "contains": { "required": ["introduced"] }
        }
      },
      "additionalProperties": false
    },
    "affected": {
      "type": "object",
      "required": ["database_specific"],
      "properties": {
        "package": {
          "type": "object",
          "required": ["ecosystem", "name"],
          "properties": {
            "ecosystem": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "purl": { "type": "string", "pattern": "^pkg:" }
          },
          "additionalProperties": false
        },
        "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "versions": { "type": "array", "items": { "type": "string" } },
        "database_specific": {
          "type": "object",
          "required": ["source", "range_source"],
          "properties": {
            "source": { "type": "string" },
            "range_source": { "type": ["string", "null"] },
            "vendor": { "type": "string" },
            "product": { "type": "string" },
            "cpe": { "type": "array", "items": { "type": "string", "pattern": "^cpe:" } },
            "purl": { "type": "string" },
            "raw_ranges": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "level_change": {
      "type": "object",
      "required": ["level", "from", "at", "reason", "decided_by"],
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "from": { "$ref": "#/$defs/level" },
        "at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "array", "items": { "type": "string" } },
        "decided_by": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record_change": {
      "type": "object",
      "required": ["type", "at"],
      "properties": {
        "type": { "$ref": "#/$defs/change_type" },
        "at": { "$ref": "#/$defs/timestamp" },
        "level_from": { "$ref": "#/$defs/level" },
        "level_to": { "$ref": "#/$defs/level" }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "required": ["kev", "exploits", "fix"],
      "properties": {
        "kev": {
          "type": "object",
          "required": ["cisa", "observed_at"],
          "properties": {
            "cisa": { "type": "boolean" },
            "date_added": { "type": ["string", "null"] },
            "observed_at": { "$ref": "#/$defs/nullable_timestamp" }
          },
          "additionalProperties": false
        },
        "ssvc": {
          "type": "object",
          "required": ["exploitation", "source_published_at", "observed_at"],
          "properties": {
            "exploitation": { "type": ["string", "null"] },
            "automatable": { "type": ["string", "null"] },
            "technical_impact": { "type": ["string", "null"] },
            "source_published_at": { "$ref": "#/$defs/nullable_timestamp" },
            "observed_at": { "$ref": "#/$defs/nullable_timestamp" }
          },
          "additionalProperties": false
        },
        "epss": {
          "type": "object",
          "required": ["score", "percentile", "date"],
          "properties": {
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "model": { "type": ["string", "null"] },
            "date": { "type": "string" },
            "delta_7d": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        },
        "exploits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "status", "origin", "url", "observed_at"],
            "properties": {
              "rule": { "enum": ["E1", "E2", "E3", "E4", "E5", null] },
              "status": { "enum": ["poc_suspicious", "poc_unverified", null] },
              "origin": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "source_published_at": { "$ref": "#/$defs/nullable_timestamp" },
              "observed_at": { "$ref": "#/$defs/nullable_timestamp" }
            },
            "additionalProperties": false
          }
        },
        "vendor_exploited": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "observed_at"],
            "properties": {
              "url": { "type": ["string", "null"] },
              "observed_at": { "$ref": "#/$defs/nullable_timestamp" }
            },
            "additionalProperties": false
          }
        },
        "fix": {
          "type": "object",
          "required": ["available", "versions"],
          "properties": {
            "available": { "type": "boolean" },
            "versions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "vuln_sentinel": {
      "type": "object",
      "required": [
        "level",
        "impact_class",
        "level_reason",
        "level_history",
        "cwe",
        "signals",
        "sources",
        "changes",
        "ai"
      ],
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "impact_class": { "enum": ["rce", "auth_bypass", "arbitrary_rw", "other"] },
        "level_reason": { "type": "array", "items": { "type": "string" } },
        "level_history": { "type": "array", "items": { "$ref": "#/$defs/level_change" } },
        "cwe": { "type": "array", "items": { "type": "string" } },
        "signals": { "$ref": "#/$defs/signals" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "source_published_at", "observed_at"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "source_published_at": { "$ref": "#/$defs/nullable_timestamp" },
              "observed_at": { "$ref": "#/$defs/timestamp" }
            },
            "additionalProperties": false
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/record_change" }
        },
        "ai": {
          "type": "object",
          "required": ["used"],
          "properties": { "used": { "type": "boolean" } }
        }
      },
      "additionalProperties": false,
      "if": { "properties": { "level": { "const": "none" } } },
      "else": { "properties": { "level_reason": { "minItems": 1 } } }
    },
    "record": {
      "type": "object",
      "required": ["schema_version", "id", "aliases", "published", "modified", "database_specific"],
      "properties": {
        "schema_version": { "const": "1.9.2" },
        "id": { "$ref": "#/$defs/alert_id" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "prefixItems": [{ "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" }],
          "uniqueItems": true
        },
        "related": { "type": "array", "items": { "$ref": "#/$defs/alert_id" } },
        "published": { "$ref": "#/$defs/timestamp" },
        "modified": { "$ref": "#/$defs/timestamp" },
        "withdrawn": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "severity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "score"],
            "properties": {
              "type": { "enum": ["CVSS_V2", "CVSS_V3", "CVSS_V4"] },
              "score": { "type": "string" },
              "source": { "enum": ["NVD", "CNA", "SELF"] }
            },
            "additionalProperties": false
          }
        },
        "affected": { "type": "array", "items": { "$ref": "#/$defs/affected" } },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": {
                "enum": [
                  "ADVISORY",
                  "ARTICLE",
                  "DETECTION",
                  "DISCUSSION",
                  "REPORT",
                  "FIX",
                  "INTRODUCED",
                  "GIT",
                  "PACKAGE",
                  "EVIDENCE",
                  "WEB"
                ]
              },
              "url": { "type": "string", "pattern": "^https?://" }
            },
            "additionalProperties": false
          }
        },
        "database_specific": {
          "type": "object",
          "required": ["vuln_sentinel"],
          "properties": { "vuln_sentinel": { "$ref": "#/$defs/vuln_sentinel" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "change_entry": {
      "type": "object",
      "required": ["id", "modified", "level", "type", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/alert_id" },
        "modified": { "$ref": "#/$defs/timestamp" },
        "level": { "$ref": "#/$defs/level" },
        "type": { "$ref": "#/$defs/change_type" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "source_status": {
      "description": "Salud de una fuente en el índice «head»: estado actual y desde cuándo (PLAN §11).",
      "type": "object",
      "required": ["name", "status", "since"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "partial", "unknown"] },
        "since": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "changes_page": {
      "type": "object",
      "required": ["schema_version", "kind", "feed", "sealed", "entries"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "kind": { "const": "changes" },
        "feed": { "enum": ["all", "alerts"] },
        "sealed": { "type": "boolean" },
        "hour": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}$" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/change_entry" } },
        "next": { "type": ["string", "null"] },
        "has_more": { "type": "boolean" },
        "modified": { "$ref": "#/$defs/timestamp" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source_status" } }
      },
      "additionalProperties": false,
      "dependentRequired": { "modified": ["sources"], "sources": ["modified"] },
      "if": { "properties": { "sealed": { "const": true } } },
      "then": {
        "required": ["hour"],
        "not": { "anyOf": [{ "required": ["next"] }, { "required": ["modified"] }] }
      },
      "else": { "required": ["generated_at", "next", "has_more"], "not": { "required": ["hour"] } }
    },
    "alerts_latest": {
      "type": "object",
      "required": ["schema_version", "kind", "feed", "generated_at", "alerts"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "kind": { "const": "alerts_latest" },
        "feed": { "const": "alerts" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "modified", "level", "sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/alert_id" },
              "modified": { "$ref": "#/$defs/timestamp" },
              "level": { "enum": ["A", "B", "C"] },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gone": {
      "type": "object",
      "required": ["error", "status", "detail", "snapshot"],
      "properties": {
        "error": { "const": "gone" },
        "status": { "const": 410 },
        "detail": { "type": "string" },
        "snapshot": { "type": "string", "pattern": "^https://.+/v1/feed/all/snapshot/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.zip$" }
      },
      "additionalProperties": false
    },
    "jwks": {
      "type": "object",
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kty", "crv", "x", "y", "kid", "use", "alg"],
            "properties": {
              "kty": { "const": "EC" },
              "crv": { "const": "P-256" },
              "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
              "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
              "kid": { "type": "string", "minLength": 1 },
              "use": { "const": "sig" },
              "alg": { "const": "ES256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
